{
  "expo": {
    "name": "ApexDrive",
    "slug": "apexdrive",
    "version": "0.15.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1523",
    "ios": {
      "bundleIdentifier": "com.apexdrive.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "ApexDrive sürüş hızını, mesafeyi ve rotayı kaydetmek için konumunu kullanır.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Ekran kapalıyken de sürüşünü kaydetmek için konum gerekir.",
        "NSPhotoLibraryUsageDescription": "Bölgeler için istediğin fotoğrafı seçebilmen için galeriye erişir."
      }
    },
    "android": {
      "package": "com.apexdrive.app",
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "monochromeImage": "./adaptive-monochrome.png",
        "backgroundColor": "#0B2B4A"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "REQUEST_INSTALL_PACKAGES",
        "POST_NOTIFICATIONS",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./notification-icon.png",
          "color": "#2A9D9D"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B2B4A"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Galerindeki fotoğraflara erişim gerekir.",
          "savePhotosPermission": "Hikayeleri galerine kaydetmek için izin gerekir.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}